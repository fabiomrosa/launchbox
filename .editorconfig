# EditorConfig helps maintain consistent coding styles across editors and IDEs
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Dockerfile
[Dockerfile]
indent_size = 4

# Makefile, Go, and gitmodules
[{Makefile,*.go,.gitmodules}]
indent_style = tab
indent_size = 4

# Go dependencies and checksums files
[go.{mod,work,work.sum,sum}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

# JavaScript/TypeScript
[*.{js,ts,jsx,tsx}]
indent_style = space
indent_size = 2

# JSON
[*.json]
indent_style = space
indent_size = 2

# Markdown, YAML, and JSON files
[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false  # Important for Markdown to preserve trailing spaces

# Ruby and Rails files
[*.{rb,rake,gemspec,ru}]
indent_style = space
indent_size = 2
